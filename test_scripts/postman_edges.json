              "}",
              "",
              "pm.test('创建边成功', function() {",
              "    pm.expect(body.code).to.eql(0);",
              "    pm.expect(body.data).to.have.property('id');",
              "    pm.expect(body.data.topologyId).to.eql(pm.collectionVariables.get('topologyId'));",
              "    pm.expect(body.data.edgeTypeId).to.eql(pm.collectionVariables.get('edgeTypeId'));",
              "    pm.expect(body.data.sourceId).to.eql(pm.collectionVariables.get('node1Id'));",
              "    pm.expect(body.data.targetId).to.eql(pm.collectionVariables.get('node2Id'));",
              "    pm.expect(body.data.status).to.eql('up');",
              "});"
