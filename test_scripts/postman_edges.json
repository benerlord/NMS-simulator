      "name": "[SETUP] 创建测试拓扑",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var body = pm.response.json();",
              "if (body.code === 0 && body.data && body.data.id) {",
              "    pm.collectionVariables.set('topologyId', body.data.id);",
              "    console.log('拓扑已创建:', body.data.id);",
              "}",
              "",
              "pm.test('创建拓扑成功', function() {",
              "    pm.expect(body.code).to.eql(0);",
              "    pm.expect(body.data).to.have.property('id');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
