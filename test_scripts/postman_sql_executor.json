      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('状态 404 + 40101', function() {",
              "    pm.expect(pm.response.code).to.eql(404);",
              "    pm.expect(pm.response.json().detail.code).to.eql(40101);",
              "});"
