    {
      "name": "preview: 不执行只返回拼接 SQL",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var body = pm.response.json();",
              "pm.test('含 generatedSql / countSql / boundParams', function() {",
              "    pm.expect(body.code).to.eql(0);",
              "    pm.expect(body.data.generatedSql).to.include('WITH');",
              "    pm.expect(body.data.countSql).to.include('COUNT(*)');",
              "    pm.expect(body.data.boundParams.__tid__).to.eql(pm.collectionVariables.get('topologyId'));",
              "});",
              "pm.test('page/pageSize 反映在 boundParams', function() {",
              "    pm.expect(body.data.boundParams.__limit__).to.eql(5);",
              "    pm.expect(body.data.boundParams.__offset__).to.eql(5);",
              "});"
            ]
          }
        }
