				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('返回码 200', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('code=0', function() {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.code).to.eql(0);",
							"});",
							"pm.test('id=nt_switch', function() {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.id).to.eql('nt_switch');",
							"});",
							"pm.test('code=switch', function() {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.code).to.eql('switch');",
							"});",
							"pm.test('category=physical', function() {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.category).to.eql('physical');",
							"});",
							"pm.test('name=交换机', function() {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.name).to.eql('交换机');",
							"});",
							"pm.test('fields 是数组', function() {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.fields).to.be.an('array');",
							"});",
							"pm.test('fields 包含预置字段 vendor', function() {",
							"    var jsonData = pm.response.json();",
							"    var hasVendor = jsonData.data.fields.some(function(f) {",
							"        return f.field_key === 'vendor';",
							"    });",
							"    pm.expect(hasVendor).to.be.true;",
							"});"
						]
					}
				}
			],
