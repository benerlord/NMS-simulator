	"item": [
		{
			"name": "NODE_TYPES - 列表查询",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('返回码 200', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('code=0', function() {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.code).to.eql(0);",
							"});",
							"pm.test('message=ok', function() {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.eql('ok');",
							"});",
							"pm.test('items 是数组', function() {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.items).to.be.an('array');",
							"});",
							"pm.test('total 大于 0', function() {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.total).to.be.above(0);",
							"});",
							"pm.test('预置类型存在 (switch)', function() {",
							"    var jsonData = pm.response.json();",
							"    var hasSwitch = jsonData.data.items.some(function(item) {",
							"        return item.code === 'switch';",
							"    });",
							"    pm.expect(hasSwitch).to.be.true;",
							"});",
							"pm.test('预置类型存在 (router)', function() {",
							"    var jsonData = pm.response.json();",
							"    var hasRouter = jsonData.data.items.some(function(item) {",
							"        return item.code === 'router';",
							"    });",
							"    pm.expect(hasRouter).to.be.true;",
							"});",
							"pm.test('预置类型存在 (pod)', function() {",
							"    var jsonData = pm.response.json();",
							"    var hasPod = jsonData.data.items.some(function(item) {",
							"        return item.code === 'pod';",
							"    });",
							"    pm.expect(hasPod).to.be.true;",
							"});",
							"pm.test('每项包含 fields 数组', function() {",
							"    var jsonData = pm.response.json();",
							"    jsonData.data.items.forEach(function(item) {",
							"        pm.expect(item.fields).to.be.an('array');",
							"    });",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/node-types",
					"host": ["{{baseUrl}}"],
					"path": ["node-types"]
				},
				"description": "获取 node_types 列表"
			}
		},
		{
			"name": "NODE_TYPES - 获取单个详情",
