          "mode": "raw",
          "raw": "{\n    \"name\": \"拓扑不存在\",\n    \"method\": \"GET\",\n    \"path\": \"/rest/openapi/bad-topo\",\n    \"data_source\": \"static\",\n    \"topology_id\": \"topo_nonexistent\",\n    \"config\": {}\n}"
        },
        "url": { "raw": "{{baseUrl}}/apis", "host": ["{{baseUrl}}"], "path": ["apis"] }
