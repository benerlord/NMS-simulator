{
  "info": {
    "name": "M2-09 接口配置 CRUD API",
    "description": "接口配置（api_configs）CRUD API 验收测试：method+path 唯一约束、enabled/topology PATCH 独立端点、异常错误码覆盖",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/admin/api" },
    { "key": "topologyId", "value": "" },
    { "key": "topologyId2", "value": "" },
    { "key": "apiId1", "value": "" },
    { "key": "apiId2", "value": "" }
  ],
  "auth": { "type": "noauth" },
  "item": [
    {
      "name": "[SETUP] 创建测试拓扑 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var body = pm.response.json();",
              "if (body.code === 0 && body.data && body.data.id) {",
              "    pm.collectionVariables.set('topologyId', body.data.id);",
              "}",
              "pm.test('创建拓扑 1 成功', function() {",
              "    pm.expect(body.code).to.eql(0);",
              "    pm.expect(body.data).to.have.property('id');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"ApiCfgTopo1_{{$timestamp}}\",\n    \"description\": \"API config test\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/topologies", "host": ["{{baseUrl}}"], "path": ["topologies"] }
      }
    },
    {
      "name": "[SETUP] 创建测试拓扑 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var body = pm.response.json();",
              "if (body.code === 0 && body.data && body.data.id) {",
              "    pm.collectionVariables.set('topologyId2', body.data.id);",
              "}",
              "pm.test('创建拓扑 2 成功', function() {",
              "    pm.expect(body.code).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"ApiCfgTopo2_{{$timestamp}}\",\n    \"description\": \"for topology switch\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/topologies", "host": ["{{baseUrl}}"], "path": ["topologies"] }
      }
    },

    {
      "name": "POST 创建接口配置（SQL 模式）",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var body = pm.response.json();",
              "if (body.code === 0 && body.data && body.data.id) {",
              "    pm.collectionVariables.set('apiId1', body.data.id);",
              "}",
              "pm.test('状态 200', function() { pm.response.to.have.status(200); });",
              "pm.test('返回 ID + 详情', function() {",
              "    pm.expect(body.code).to.eql(0);",
              "    pm.expect(body.data.id).to.match(/^api_[a-f0-9]{12}$/);",
              "    pm.expect(body.data.method).to.eql('GET');",
              "    pm.expect(body.data.enabled).to.be.true;",
              "    pm.expect(body.data.data_source).to.eql('sql');",
              "    pm.expect(body.data.sql_text).to.include('SELECT');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"设备查询接口\",\n    \"method\": \"GET\",\n    \"path\": \"/rest/openapi/network/v1/devices\",\n    \"enabled\": true,\n    \"group_name\": \"ManageOne\",\n    \"data_source\": \"sql\",\n    \"topology_id\": \"{{topologyId}}\",\n    \"sql_text\": \"SELECT * FROM switches WHERE (:status IS NULL OR status=:status)\",\n    \"config\": {\n        \"auth\": {\"type\": \"xtoken\", \"headerName\": \"X-Auth-Token\"},\n        \"pagination\": {\"enabled\": true, \"pageNoParam\": \"pageNo\", \"pageSizeParam\": \"pageSize\", \"defaultPageSize\": 100}\n    }\n}"
        },
        "url": { "raw": "{{baseUrl}}/apis", "host": ["{{baseUrl}}"], "path": ["apis"] }
      }
    },
    {
      "name": "POST 创建接口配置（static 模式，不同 method/path）",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var body = pm.response.json();",
              "if (body.code === 0 && body.data && body.data.id) {",
              "    pm.collectionVariables.set('apiId2', body.data.id);",
              "}",
              "pm.test('创建第二条成功', function() {",
              "    pm.expect(body.code).to.eql(0);",
              "    pm.expect(body.data.data_source).to.eql('static');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"静态接口\",\n    \"method\": \"POST\",\n    \"path\": \"/rest/openapi/network/v1/devices\",\n    \"enabled\": false,\n    \"data_source\": \"static\",\n    \"config\": {\"response\": {\"statusCode\": 200, \"template\": {\"code\": 0}}}\n}"
        },
        "url": { "raw": "{{baseUrl}}/apis", "host": ["{{baseUrl}}"], "path": ["apis"] }
      }
    },

    {
      "name": "POST method+path 冲突 → 409/40301",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var body = pm.response.json();",
              "pm.test('HTTP 409', function() { pm.response.to.have.status(409); });",
              "pm.test('code=40301', function() {",
              "    pm.expect(body.detail.code).to.eql(40301);",
              "    pm.expect(body.detail.message).to.include('已存在');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"重复接口\",\n    \"method\": \"GET\",\n    \"path\": \"/rest/openapi/network/v1/devices\",\n    \"data_source\": \"static\",\n    \"config\": {}\n}"
        },
        "url": { "raw": "{{baseUrl}}/apis", "host": ["{{baseUrl}}"], "path": ["apis"] }
      }
    },
    {
      "name": "POST SQL 模式缺 sqlText → 400/40001",
