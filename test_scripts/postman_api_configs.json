        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"缺SQL\",\n    \"method\": \"GET\",\n    \"path\": \"/rest/openapi/missing-sql\",\n    \"data_source\": \"sql\",\n    \"config\": {}\n}"
        },
        "url": { "raw": "{{baseUrl}}/apis", "host": ["{{baseUrl}}"], "path": ["apis"] }
