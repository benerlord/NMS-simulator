			"name": "SETUP - 创建拓扑",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('返回码 200', function() { pm.response.to.have.status(200); });",
							"pm.test('code=0', function() { pm.expect(pm.response.json().code).to.eql(0); });",
							"pm.test('保存 topo_id', function() { pm.collectionVariables.set('topo_id', pm.response.json().data.id); });"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n    \"name\": \"NodeTestTopology\"\n}" },
				"url": { "raw": "{{baseUrl}}/topologies", "host": ["{{baseUrl}}"], "path": ["topologies"] }
			}
		},
		{
			"name": "NODES - 列表查询（空）",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('返回码 200', function() { pm.response.to.have.status(200); });",
							"pm.test('code=0', function() { pm.expect(pm.response.json().code).to.eql(0); });",
							"pm.test('total=0', function() { pm.expect(pm.response.json().data.total).to.eql(0); });",
							"pm.test('items 是空数组', function() { pm.expect(pm.response.json().data.items).to.be.an('array').that.has.length(0); });"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/topologies/{{topo_id}}/nodes",
					"host": ["{{baseUrl}}"],
					"path": ["topologies", "{{topo_id}}", "nodes"]
				}
			}
		},
		{
			"name": "NODES - 创建节点1",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('返回码 200', function() { pm.response.to.have.status(200); });",
							"var d = pm.response.json();",
							"pm.test('code=0', function() { pm.expect(d.code).to.eql(0); });",
							"pm.test('返回完整数据', function() {",
							"    pm.expect(d.data.id).to.be.a('string');",
							"    pm.expect(d.data.name).to.eql('Switch-1');",
							"    pm.expect(d.data.dn).to.eql('sw1');",
							"    pm.expect(d.data.status).to.eql('online');",
							"    pm.expect(d.data.topologyId).to.eql(pm.collectionVariables.get('topo_id'));",
							"    pm.expect(d.data.nodeTypeId).to.eql('nt_switch');",
							"    pm.expect(d.data.attrs).to.be.an('object');",
							"});",
							"pm.collectionVariables.set('node_id', d.data.id);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nodeTypeId\": \"nt_switch\",\n    \"name\": \"Switch-1\",\n    \"dn\": \"sw1\",\n    \"status\": \"online\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/topologies/{{topo_id}}/nodes",
					"host": ["{{baseUrl}}"],
					"path": ["topologies", "{{topo_id}}", "nodes"]
				}
			}
		},
