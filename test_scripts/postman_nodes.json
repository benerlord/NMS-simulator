{
	"info": {
		"name": "Nodes API",
		"_postman_id": "nodes-crud",
		"description": "M2-02 节点 CRUD API 测试集（嵌套路由 + camelCase）",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080/admin/api" },
		{ "key": "topo_id", "value": "" },
